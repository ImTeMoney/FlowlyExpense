# Copy this file to .env.local and fill in your values.
# .env.local is git-ignored and must never be committed to version control.

# ── Receipt OCR (optional) ────────────────────────────────────────────────────
# Required for automatic receipt scanning.  Without this key the receipt
# attachment feature still works but fields must be filled manually.
#
# Get your key at https://console.anthropic.com
#
# ⚠  SECURITY: VITE_* variables are bundled into the browser JS at build time.
#    Only deploy this app to a private URL you control, never a public host.
VITE_ANTHROPIC_API_KEY=sk-ant-
